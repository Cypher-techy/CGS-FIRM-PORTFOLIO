# Configure a dedicated CGS corporate Supabase project. Leave blank for local read-only preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS deployment origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=
# Optional: verified sending identity + monitored recipient
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_EMAIL=
